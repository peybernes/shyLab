// -*- c++ -*- (for emacs users)
#include "kernel_advection_fv_uw_kappa_2d.h"

#include <assert.h>
#include <math.h>
#include <xmmintrin.h>

#include "kernel_tools.h"

#define MIN(a, b)           (((a) < (b))? (a): (b))


#define RESTRICT __restrict__

void AdvectionFvUwKappa2d(int nx, 
			  int ny, 
			  int CX,
			  int CY,
			  RealType dt,
			  RealType dx,
			  RealType dy,
			  RealType kappa,
			  const RealType* RESTRICT in_value, 
			  const RealType* RESTRICT in_velocity_x,
			  const RealType* RESTRICT in_velocity_y,
			  RealType* RESTRICT out_value) {

  assert(0 < dx);
  assert(0 < dy);
  assert(0 <= dt);

  const RealType cx = 1.0 / dx;
  const RealType cy = 1.0 / dy;

  const int ybegin = 2;
  const int yend = ny - 2;

  const int xbegin = 2;
  const int xend = nx - 2;

#pragma omp parallel for
  for (int by = ybegin; by < yend; by += CY) {
    for (int iy = by; iy < MIN(by + CY, yend); ++iy) {
      for (int ix = xbegin; ix < xend; ++ix) {

	  const int i = ix;
	  const int j = iy;

	  // assert((xbegin <= i) && (i < xend));
	  // assert((ybegin <= j) && (j < yend));

	  const int ooo = (nx * j) + i;

	  const int m2o = (nx * j) + i - 2;
	  const int m1o = (nx * j) + i - 1;
	  const int p1o = (nx * j) + i + 1;
	  const int p2o = (nx * j) + i + 2;

	  const int om2 = (nx * (j - 2)) + i;      
	  const int om1 = (nx * (j - 1)) + i;
	  const int op1 = (nx * (j + 1)) + i;
	  const int op2 = (nx * (j + 2)) + i;

	  const int f_mo = (nx * j) + i;
	  const int f_po = (nx * j) + i + 1;
	  const int f_om = (nx * j) + i;
	  const int f_op = (nx * j) + i + 1;

	  const RealType u_face_mo = in_velocity_x[f_mo];
	  const RealType u_face_po = in_velocity_x[f_po];
	  const RealType u_face_om = in_velocity_y[f_om];
	  const RealType u_face_op = in_velocity_y[f_op];

	  const RealType in_cell_ooo = in_value[ooo];

	  const RealType in_cell_m2o = in_value[m2o];
	  const RealType in_cell_m1o = in_value[m1o];
	  const RealType in_cell_p1o = in_value[p1o];
	  const RealType in_cell_p2o = in_value[p2o];

	  const RealType in_cell_om2 = in_value[om2];
	  const RealType in_cell_om1 = in_value[om1];
	  const RealType in_cell_op1 = in_value[op1];
	  const RealType in_cell_op2 = in_value[op2];

	  const RealType half = 0.5;
	  const RealType one_quarter = 0.25;

	  // Reconstructed values at faces (left and right).

	  // x direction.
	  const RealType s_mo = VanAlbadaLimiter(in_cell_m1o - in_cell_m2o, in_cell_ooo - in_cell_m1o);
	  const RealType s_po = 1.0;//VanAlbadaLimiter(in_cell_m1o - in_cell_ooo, in_cell_ooo - in_cell_p1o);

	  const RealType in_cell_left_mo =  ReconstructValueLefftKappa(in_cell_m1o, s_mo, kappa, in_cell_m1o - in_cell_m2o, in_cell_ooo - in_cell_m1o);
	  // const RealType in_cell_right_mo = ReconstructValueRiteKappa(in_cell_ooo, s_mo, kappa, in_cell_ooo - in_cell_m1o, in_cell_p1o - in_cell_ooo);

	  // const RealType in_cell_left_po =  ReconstructValueLeftKappa(in_cell_ooo, s_po, kappa, in_cell_ooo - in_cell_m1o, in_cell_p1o - in_cell_ooo);
	  // const RealType in_cell_right_po = ReconstructValueRiteKappa(in_cell_p1o, s_po, kappa, in_cell_p1o - in_cell_ooo, in_cell_p2o - in_cell_p1o);

	  //const RealType in_cell_left_mo =  1.0;
	  const RealType in_cell_right_mo = 1.0;

	  const RealType in_cell_left_po =  1.0;
	  const RealType in_cell_right_po = 1.0;


	  // y direction.
	  const RealType s_om = 1.0;//VanAlbadaLimiter(in_cell_om1 - in_cell_om2, in_cell_ooo - in_cell_om1);
	  const RealType s_op = 1.0;//VanAlbadaLimiter(in_cell_ooo - in_cell_om1, in_cell_op1 - in_cell_ooo);

	  // const RealType in_cell_left_om =  ReconstructValueLeftKappa(in_cell_om1, s_om, kappa, in_cell_om1 - in_cell_om2, in_cell_ooo - in_cell_om1);
	  // const RealType in_cell_right_om = ReconstructValueRiteKappa(in_cell_ooo, s_om, kappa, in_cell_ooo - in_cell_om1, in_cell_op1 - in_cell_ooo);

	  // const RealType in_cell_left_op =  ReconstructValueLeftKappa(in_cell_ooo, s_op, kappa, in_cell_ooo - in_cell_om1, in_cell_op1 - in_cell_ooo);
	  // const RealType in_cell_right_op = ReconstructValueRiteKappa(in_cell_op1, s_op, kappa, in_cell_op1 - in_cell_ooo, in_cell_op2 - in_cell_op1);

	  const RealType in_cell_left_om =  1.0;
	  const RealType in_cell_right_om = 1.0;

	  const RealType in_cell_left_op =  1.0;
	  const RealType in_cell_right_op = 1.0;


	  // Numerical fluxes at faces (simple upwinding for linear advection).
	  const RealType flux_face_mo = half * cx * ((fabs(u_face_mo) + u_face_mo) * in_cell_left_mo + (u_face_mo - fabs(u_face_mo)) * in_cell_right_mo);
	  const RealType flux_face_po = half * cx * ((fabs(u_face_po) + u_face_po) * in_cell_left_po + (u_face_po - fabs(u_face_po)) * in_cell_right_po);

	  const RealType flux_face_om = half * cy * ((fabs(u_face_om) + u_face_om) * in_cell_left_om + (u_face_om - fabs(u_face_om)) * in_cell_right_om);
	  const RealType flux_face_op = half * cy * ((fabs(u_face_op) + u_face_op) * in_cell_left_op + (u_face_op - fabs(u_face_op)) * in_cell_right_op);

	  const RealType out_cell_oo = in_cell_ooo + dt * (flux_face_mo - flux_face_po + flux_face_om - flux_face_op);

	  out_value[ooo] = out_cell_oo;

	}
      }
  }

}
