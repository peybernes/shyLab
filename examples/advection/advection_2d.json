// -*- js -*- (for emacs users)
{
    "Simulation": {

	"Clock": { "time": "0.0",
		   "iteration": "0" },

	"Timetable": { "iend": "999" },
	
	"Grid": { "nx": "100",
		  "ny": "100",
		  "xmin": "0.0",
		  "xmax": "1.0",
		  "ymin": "0.0",
		  "ymax": "1.0" },

    	"Events": {
    	
	    "InitVariable": { "name": "in_rho",
    			      "expression": "((abs(x - 0.25) < 0.125) && (abs(y - 0.25) < 0.125)) ? 1.0 : 0.125" },

	    "InitVariable": { "name": "out_rho",
    			      "expression": "in_rho" },

	    "InitVariable": { "name": "in_u",
    			      "expression": "1.0" },

	    "InitVariable": { "name": "in_v",
    			      "expression": "1.0" },

	    "OutputSimulation": { "filename": "result/sim%i",
	    			  "Timetable": {"istep": "100"}},

	    "OutputCartesianLine": { "filename": "result/profile%i",
	    			     "direction": "x",
	    			     "indice": "4",
	    			     "Timetable": {"istep": "200"}}

			      
    	}
    	
    }
}
