<?xml version="1.0" encoding="utf-8"?>

<Simulation>

  <Clock>
    <time>0.</time>
    <iteration>0</iteration>
  </Clock>
  
  <Timetable>
    <iend>500</iend>
  </Timetable>

  <Grid>
    <nx>100</nx>
    <ny>5</ny>
    <xmin>0.0</xmin>
    <xmax>1.0</xmax>
    <ymin>0.0</ymin>
    <ymax>0.05</ymax>
  </Grid>

  <Events>

    <InitVariable>
      <name>rho_ref</name>
      <Timetable>
    	<istep>1</istep>
      </Timetable>
     <expression>- (cell_centers_x - t >= 0.25) * (0.5 >= cell_centers_x - t) * sin(4.0 * pi * (cell_centers_x - t))</expression>
    </InitVariable>

    <InitVariable>
      <name>in_rho</name>
     <expression>- (cell_centers_x >= 0.25) * (0.5 >= cell_centers_x) * sin(4.0 * pi * cell_centers_x)</expression>
    </InitVariable>

    <InitVariable>
      <name>u_face</name>
      <expression>1</expression>
    </InitVariable>

    <OutputSimulation>
      <filename>result/sim%i</filename>
      <format>binary</format>
      <Timetable>
    	<istep>10</istep>
      </Timetable>
    </OutputSimulation>

    <OutputNorms>
      <filename>comparison.txt</filename>
      <format>binary</format>
      <Timetable>
    	<istep>1</istep>
      </Timetable>
      <variable1>rho_ref</variable1>
      <variable2>out_rho</variable2>
    </OutputNorms>


  </Events>

</Simulation>
