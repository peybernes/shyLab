// -*- js -*- (for emacs users)
{
    "Simulation": {

	"Clock": { "time": "0.0",
		   "iteration": "0" },

	"Timetable": { "iend": "1" },
	
	"Grid": { "nx": "100",
		  "ny": "10",
		  "xmin": "0.0",
		  "xmax": "1.0",
		  "ymin": "0.0",
		  "ymax": "0.1" },

    	"Events": {
    	
	    "InitVariable": { "name": "in_rho",
    			      "expression": "(x < 0.5) ? 1.0 : 0.125" },

	    "OutputSimulation": { "filename": "result/sim%i",
	    			  "timetable": {"istep": "10"}}
			      
    	}
    	
    }
}
