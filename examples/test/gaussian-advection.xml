<?xml version="1.0" encoding="utf-8"?>

<Simulation>

  <Clock>
    <time>0.</time>
    <iteration>0</iteration>
  </Clock>
  
  <Timetable>
    <end>0.25</end>
  </Timetable>

  <Grid>
    <nx>100</nx>
    <ny>5</ny>
    <xmin>0.0</xmin>
    <xmax>1.0</xmax>
    <ymin>0.0</ymin>
    <ymax>0.05</ymax>
  </Grid>

  <Events>

    <InitVariable>
      <name>in_rho</name>
     <expression>0.2 * exp(- 100.0 * (cell_centers_x - 0.5) * (cell_centers_x - 0.5))</expression>
    </InitVariable>

    <InitVariable>
      <name>u_face</name>
      <expression>1</expression>
    </InitVariable>

    <InitVariable>
      <name>rho_ref</name>
      <Timetable>
    	<step>0.05</step>
      </Timetable>
     <expression>0.2 * exp(- 100.0 * (cell_centers_x - 0.5 - t) * (cell_centers_x - 0.5 - t))</expression>
    </InitVariable>

    <OutputNorms>
      <filename>comparison.txt</filename>
      <format>binary</format>
      <Timetable>
    	<step>0.05</step>
      </Timetable>
      <variable1>rho_ref</variable1>
      <variable2>out_rho</variable2>
    </OutputNorms>

    <OutputSimulation>
      <filename>result/sim%i</filename>
      <format>binary</format>
      <Timetable>
    	<step>0.05</step>
      </Timetable>
    </OutputSimulation>

  </Events>

</Simulation>
