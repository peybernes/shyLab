// -*- js -*- (for emacs users)
{
    "Simulation": {

	"Clock": { "time": "0.0",
		   "iteration": "0" },

	"Timetable": { "iend": "999" },
	
	"Grid": { "nx": "200",
		  "ny": "20",
		  "xmin": "0.0",
		  "xmax": "1.0",
		  "ymin": "0.0",
		  "ymax": "0.1" },

    	"Events": {
    	
	    "InitVariable": { "name": "in_rho",
    			      "expression": "(x > 0.5) ? 1.0 : 0.125" },

	    "InitVariable": { "name": "out_rho",
    			      "expression": "in_rho" },

	    "InitVariable": { "name": "in_e",
    			      "expression": "(x > 0.5) ? 2.5 : 2.0" },

	    "InitVariable": { "name": "out_e",
    			      "expression": "in_e" },

	    "OutputSimulation": { "filename": "result/sim%i",
	    			  "Timetable": {"istep": "100"}},

	    "OutputCartesianLine": { "filename": "result/profile%i",
	    			     "direction": "x",
	    			     "indice": "4",
	    			     "Timetable": {"istep": "200"}}

			      
    	}
    	
    }
}
