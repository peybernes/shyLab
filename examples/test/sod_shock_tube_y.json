// -*- js -*- (for emacs users)
{
    "Simulation": {

	"Clock": { "time": "0.0",
		   "iteration": "0" },

	"Timetable": { "iend": "999" },
	
	"Grid": { "name": "grid",
		  "nx": "20",
		  "ny": "200",
		  "xmin": "0.0",
		  "xmax": "0.1",
		  "ymin": "0.0",
		  "ymax": "1.0" },

	"Variables": {

	    "directional_lagrangian_volume_y"  : {"support": "cell"},
	    "directional_lagrangian_density_y"  : {"support": "cell"},

	    "in_rho"  : {"support": "cell"},
	    "out_rho" : {"support": "cell"},

	    "in_cell_mass"  : {"support": "cell"},
	    "out_cell_mass" : {"support": "cell"},

	    "in_e"  : {"support": "cell"},
	    "out_e" : {"support": "cell"},

	    "in_pressure"  : {"support": "cell"},

	    "rho_ref" : {"support": "cell"},
	    "p_ref" : {"support": "cell"},

	    "lagrangian_u"  : {"support": "vertice"},
	    "lagrangian_v"  : {"support": "vertice"},

	    "in_u"  : {"support": "vertice"},
	    "in_v"  : {"support": "vertice"},

	    "predicted_u"  : {"support": "vertice"},
	    "predicted_v"  : {"support": "vertice"},

	    "out_u" : {"support": "vertice"},
	    "out_v" : {"support": "vertice"},

	    "u_ref" : {"support": "vertice"}

	},


    	"Events": {
    	
	    "InitVariable": { "name": "in_rho",
    			      "expression": "(y < 0.5) ? 1.0 : 0.125" },

	    "InitVariable": { "name": "out_rho",
    			      "expression": "in_rho" },

	    "InitVariable": { "name": "in_e",
    			      "expression": "(y < 0.5) ? 2.5 : 2.0" },

	    "InitVariable": { "name": "out_e",
    			      "expression": "in_e" },

	    "OutputSimulation": { "filename": "result/sim%i",
	    			  "Timetable": {"istep": "100"}},

	    "OutputCartesianLine": { "filename": "result/profile%i",
	    			     "direction": "y",
	    			     "indice": "9",
	    			     "Timetable": {"istep": "200"}}

			      
    	}
    	
    }
}
